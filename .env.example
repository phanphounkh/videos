# =============================================================================
# AI Video Studio - environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit secrets.
# =============================================================================

# --- general ---------------------------------------------------------------
APP_NAME=AI Video Studio
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api

# --- security --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- host port mapping -----------------------------------------------------
# Offset from the defaults so this stack never collides with other projects.
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6381
S3_HOST_PORT=9100
S3_CONSOLE_HOST_PORT=9101
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5174

# --- database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_video_studio
# Value below is for running the backend ON THE HOST against dockerised Postgres.
# docker-compose.yml overrides it with postgres:5432 for in-container runs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/ai_video_studio

# --- redis (cache + ARQ job queue) ----------------------------------------
REDIS_URL=redis://localhost:6381/0

# --- object storage (MinIO locally, S3-compatible later) ------------------
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-video-studio
S3_REGION=us-east-1
# URL the BROWSER uses to fetch media. Must be reachable from your machine.
S3_PUBLIC_BASE_URL=http://localhost:9100
# URL the RENDERER (headless Chromium in the worker) uses. Leave empty to reuse
# S3_ENDPOINT_URL; docker-compose.yml sets it to http://s3:8333 for the worker.
S3_RENDERER_BASE_URL=http://localhost:9100

# --- LLM (OpenRouter) ------------------------------------------------------
# LLM_PROVIDER=mock works with no API key and returns a deterministic script.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- text to speech --------------------------------------------------------
# edge = REAL speech via Microsoft Edge neural voices. No API key required, and
#        it includes Khmer (km-KH-PisethNeural / km-KH-SreymomNeural).
#        It is an unauthenticated public endpoint: no SLA, fine for dev and
#        internal use, swap in a contractual provider for production.
# mock = silent audio of the correct duration (offline, tests)
TTS_PROVIDER=edge
TTS_API_KEY=
# Prosody, e.g. TTS_RATE=-10% narrates more slowly for beginners.
TTS_RATE=+0%
TTS_VOLUME=+0%

# --- image generation ------------------------------------------------------
IMAGE_PROVIDER=mock
IMAGE_API_KEY=

# --- renderer / uploads ----------------------------------------------------
RENDERER_DIR=../renderer
RENDER_TIMEOUT_SECONDS=1800
MAX_UPLOAD_SIZE_MB=100
# Chromium tabs per render. 1 is slow but memory-safe; raise it on a big host.
REMOTION_CONCURRENCY=1
# Per-frame budget. Raise it if renders fail with "Timeout exceeded rendering
# the component at frame N" on a loaded machine.
REMOTION_FRAME_TIMEOUT_MS=120000

# --- frontend --------------------------------------------------------------
BACKEND_URL=http://localhost:8000
