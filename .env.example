# =============================================================================
# AI Video Studio - environment template
# Copy to .env and fill in real values:  cp .env.example .env
# .env is gitignored. Never commit secrets.
# =============================================================================

# --- general ---------------------------------------------------------------
APP_NAME=AI Video Studio
ENVIRONMENT=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false
API_PREFIX=/api

# --- security --------------------------------------------------------------
# Generate with:  openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- host port mapping -----------------------------------------------------
# Offset from the defaults so this stack never collides with other projects.
POSTGRES_HOST_PORT=5435
REDIS_HOST_PORT=6381
S3_HOST_PORT=9100
S3_CONSOLE_HOST_PORT=9101
BACKEND_HOST_PORT=8010
FRONTEND_HOST_PORT=5174

# --- database --------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_video_studio
# Value below is for running the backend ON THE HOST against dockerised Postgres.
# docker-compose.yml overrides it with postgres:5432 for in-container runs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5435/ai_video_studio

# --- redis (cache + ARQ job queue) ----------------------------------------
REDIS_URL=redis://localhost:6381/0

# --- object storage (MinIO locally, S3-compatible later) ------------------
S3_ENDPOINT_URL=http://localhost:9100
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-video-studio
S3_REGION=us-east-1
# URL the BROWSER and the renderer use to fetch media. Must be host-reachable.
S3_PUBLIC_BASE_URL=http://localhost:9100

# --- LLM (OpenRouter) ------------------------------------------------------
# LLM_PROVIDER=mock works with no API key and returns a deterministic script.
LLM_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- text to speech --------------------------------------------------------
TTS_PROVIDER=mock
TTS_API_KEY=

# --- image generation ------------------------------------------------------
IMAGE_PROVIDER=mock
IMAGE_API_KEY=

# --- renderer / uploads ----------------------------------------------------
RENDERER_DIR=../renderer
RENDER_TIMEOUT_SECONDS=1800
MAX_UPLOAD_SIZE_MB=100

# --- frontend --------------------------------------------------------------
BACKEND_URL=http://localhost:8000
