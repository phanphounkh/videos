# Sorya Studio telemetry service. Copy to .env for running on the host.
# (docker-compose.yml sets the in-network values itself.)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5437/telemetry
REDIS_URL=redis://localhost:6381/0

# The stream the backend and worker write to, and this service's consumer group.
TELEMETRY_STREAM_KEY=sorya:telemetry:events
TELEMETRY_CONSUMER_GROUP=telemetry-ingest

# Must be the SAME secret the backend signs its tokens with: this service checks the
# signature itself, and asks the backend whether the caller is an admin.
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
BACKEND_URL=http://localhost:8000

# Browser ingest limits (requests per minute): signed-in people, then anonymous clients
# (login page, errors before sign-in), which are counted per IP.
INGEST_RATE_LIMIT_MAX=600
INGEST_ANON_RATE_LIMIT_MAX=120

# Events older than this are deleted once a day.
RETENTION_DAYS=90
ENABLE_DOCS=true
CORS_ORIGINS=http://localhost:5173
